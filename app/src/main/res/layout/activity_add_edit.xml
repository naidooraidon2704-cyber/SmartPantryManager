<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream">
 <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/txtTitle" android:text="Add Ingredient" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/dark_green" android:layout_marginBottom="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtName" android:hint="Ingredient name (e.g. tomato)" android:inputType="textCapWords" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtQuantity" android:hint="Quantity" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtUnit" android:hint="Unit (g, kg, ml, L, item)" android:inputType="text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtExpiry" android:hint="Expiry date (optional: YYYY-MM-DD)" android:inputType="text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnSave" android:text="Save Ingredient" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnCancel" android:text="Cancel" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
</ScrollView>